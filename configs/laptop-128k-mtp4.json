    "1792",
    "--kv-dtype",
    "q4",
    "--spec",
    "mtp",
    "--draft-tokens",
    "4",
    "--embedding-host",
    "--max-concurrency",
    "1",
    "--max-pending-requests",
    "16",
    "--pending-timeout-ms",
    "180000",
    "--prefix-checkpoint-policy",
    "rolling-tool",
    "--lm-head-draft"
  ]
